{
  "name": "wlumsa.org",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": "10.14.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "scripts": {
    "build": "next build",
    "ci": "payload migrate && pnpm build",
    "check": "pnpm check:type && pnpm check:lint && pnpm check:knip && pnpm format:check && pnpm check:smoke",
    "check:knip": "knip",
    "check:lint": "eslint .",
    "check:smoke": "node --test tests/smoke/*.test.mjs",
    "check:type": "tsc --noEmit --pretty false",
    "check:type:profile": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit --pretty false --extendedDiagnostics --incremental false",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "next start",
    "test": "pnpm check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "email": "email dev",
    "generate:types": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@googleapis/sheets": "^14.0.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/plugin-stripe": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "^0.5.7",
    "@react-email/markdown": "^0.0.18",
    "@react-email/render": "^2.2.0",
    "@sparticuz/chromium-min": "^143.0.4",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@t3-oss/env-nextjs": "^0.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "axios": "^1.21.0",
    "babel-plugin-react-compiler": "0.0.0-experimental-ff4e0fd-20260324",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "next-sitemap": "^4.2.3",
    "payload": "3.93.0",
    "posthog-js": "^1.447.1",
    "puppeteer-core": "^24.43.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.7",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-select": "^5.10.2",
    "react-social-media-embed": "^2.5.18",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@react-email/ui": "6.11.7",
    "@types/node": "^18.19.130",
    "@types/prettier": "^2.7.3",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0",
    "autoprefixer": "^10.6.2",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.32",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.13.0"
  }
}
